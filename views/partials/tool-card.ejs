<%
  let badgeClass = 'badge-community';
  if (tool.status && tool.status.includes('Graduated')) {
    badgeClass = 'badge-graduated';
  } else if (tool.status && tool.status.includes('Incubating')) {
    badgeClass = 'badge-incubating';
  }
%>
<a class="tool-card" 
   href="/tools/<%= tool.id %>"
   data-name="<%= tool.name.toLowerCase() %>"
   data-category="<%= tool.category.toLowerCase() %>"
   data-tags="<%= (tool.tags || []).join(' ').toLowerCase() %>"
   data-tagline="<%= (tool.tagline || '').toLowerCase() %>">
  
  <div class="tool-card-header">
    <div class="tool-logo-wrap">
      <img src="<%= tool.icon %>" alt="<%= tool.name %> logo" class="tool-logo" loading="lazy">
    </div>
    <div class="tool-badges">
      <span class="badge <%= badgeClass %>"><%= tool.status %></span>
    </div>
  </div>

  <div class="tool-card-category"><%= tool.category %></div>
  <h3 class="tool-card-title"><%= tool.name %></h3>
  <p class="tool-card-tagline"><%= tool.tagline %></p>

  <div class="tool-card-tags">
    <% (tool.tags || []).slice(0, 4).forEach(function(tag) { %>
      <span class="tag-pill">#<%= tag %></span>
    <% }) %>
  </div>

  <div class="tool-card-footer">
    <%- include('rating-stars', { 
      rating: tool.summary ? tool.summary.averageRating : 0, 
      count: tool.summary ? tool.summary.count : 0 
    }) %>

    <span class="tool-stars-github" title="GitHub stars">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .587l3.668 7.431 8.2 1.192-5.934 5.784 1.399 8.165-7.333-3.856-7.333 3.856 1.399-8.165-5.934-5.784 8.2-1.192zm0 5.702l-2.232 4.523-4.991.726 3.612 3.521-.852 4.969 4.463-2.347 4.463 2.347-.852-4.969 3.612-3.521-4.991-.726z"/></svg>
      <%= tool.stars %>
    </span>
  </div>
</a>
